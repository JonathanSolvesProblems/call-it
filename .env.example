# Twitch Developer Console Client ID for the public app
TWITCH_CLIENT_ID=
# Never commit this file's populated copy. OpenAI key is used by the agent loop in a later slice.
OPENAI_API_KEY=
OPENAI_MODEL=

# OBS WebSocket v5
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
FRAME_SECONDS=2
OBS_FRAME_WIDTH=1280
TICK_SECONDS=4
MIN_GAP_SECONDS=60
MAX_BET_SECONDS=900
OPENAI_IMAGE_DETAIL=high

# Local overlay server
OVERLAY_PORT=4545
