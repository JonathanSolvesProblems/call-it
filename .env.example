# Twitch Developer Console Client ID for the public app
TWITCH_CLIENT_ID=
# Never commit this file's populated copy. OpenAI key is used by the agent loop in a later slice.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESOLVE_MODEL=gpt-6.1-sol

# OBS WebSocket v5
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
FRAME_SECONDS=2
OBS_FRAME_WIDTH=1280
TICK_SECONDS=4
MIN_GAP_SECONDS=180
OBS_SOURCE_NAME=
MAX_BET_SECONDS=900
OPENAI_IMAGE_DETAIL=high

# Live spend guards. Force-live stops after 30 minutes. Live calls default to 600.
CALLIT_FORCE_LIVE=0
CALLIT_MAX_MINUTES=30
# Leave blank for 600 calls in live mode and no replay cap.
CALLIT_MAX_MODEL_CALLS=

# Local overlay server
OVERLAY_PORT=4545
